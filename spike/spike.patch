diff --git a/riscv/fi_spec.cc b/riscv/fi_spec.cc
new file mode 100644
index 00000000..f17e2bab
--- /dev/null
+++ b/riscv/fi_spec.cc
@@ -0,0 +1,95 @@
+#include "fi_spec.h"
+
+void fi_spec_parse( std::unordered_map<uint64_t,fi_spec_t> &specs, std::unordered_map<uint64_t,fi_spec_t> &pc_specs, const char* x ) {
+  fi_spec_t spec; std::stringstream tokens( x ); std::string token;
+
+  memset( &spec, 0, sizeof( fi_spec_t ) );
+
+  // type-agnostic, non-optional part(s)
+
+  getline( tokens, token, ':' );
+  bool by_pc = ( token == "pc" );
+  uint64_t key = 0;
+  if( by_pc ) {
+    getline( tokens, token, ':' );
+    key = std::stoull( token, NULL, 0 );
+  } else {
+    key = std::stoi( token, NULL, 10 );
+  }
+
+  getline( tokens, token, ':' );
+  spec.prob = std::stof( token, NULL     );
+
+  getline( tokens, token, ':' );
+
+  switch( token.at( 0 ) ) {
+    case SKIP : {
+      spec.type = SKIP; break;
+    }
+    case  GPR : {
+      spec.type =  GPR; break;
+    }
+  }
+
+  // type-specific,     optional part(s)
+
+  switch( spec.type ) {
+    case SKIP : { // <step>:<prob>:<type>
+      break;
+    }
+    case GPR  : { // <step>:<prob>:<type>:<addr>:<mode>:<mask>
+      getline( tokens, token, ':' );
+      spec.gpr_addr = std::stoi  ( token, NULL, 10 );
+
+      getline( tokens, token, ':' );
+
+      switch( token.at( 0 ) ) {
+        case ZERO : {
+          spec.gpr_mode = ZERO; break;
+        }
+        case  ONE : {
+          spec.gpr_mode =  ONE; break;
+        }
+        case RAND : {
+          spec.gpr_mode = RAND; break;
+        }
+      }
+
+      getline( tokens, token, ':' );
+      spec.gpr_mask = std::stoull( token, NULL, 16 );
+
+      break;
+    }
+  }
+
+  if( by_pc ) {
+    pc_specs[ key ] = spec;
+  } else {
+    specs[ key ] = spec;
+  }
+}
+
+std::ostream &operator<<( std::ostream &os, const fi_spec_t &spec ) {
+  switch( spec.type ) {
+    case SKIP : {
+      os << spec.prob
+         << ":"
+         << spec.type;
+      break;
+    }
+    case  GPR : {
+      os << spec.prob
+         << ":"
+         << spec.type
+         << ":"
+         << spec.gpr_addr
+         << ":"
+         << spec.gpr_mode
+         << ":"
+         << spec.gpr_mask;
+      break;
+    }
+  }
+
+  return os;
+}
diff --git a/riscv/fi_spec.h b/riscv/fi_spec.h
new file mode 100644
index 00000000..11a83cb7
--- /dev/null
+++ b/riscv/fi_spec.h
@@ -0,0 +1,32 @@
+#ifndef __FI_SPEC_H
+#define __FI_SPEC_H
+
+#include <cstdint>
+#include <cstring>
+#include <iostream>
+#include <iomanip>
+#include <random>
+#include <unordered_map>
+
+typedef enum {
+  SKIP = 's', GPR = 'r'
+} fi_type_t;
+
+typedef enum {
+  ZERO = '0', ONE = '1', RAND = '?'
+} fi_mode_t;
+
+typedef struct {
+  float         prob;
+  fi_type_t     type;
+
+  uint64_t  gpr_addr;
+  fi_mode_t gpr_mode;
+  uint64_t  gpr_mask;
+} fi_spec_t;
+
+extern void fi_spec_parse( std::unordered_map<uint64_t,fi_spec_t> &specs, std::unordered_map<uint64_t,fi_spec_t> &pc_specs, const char* x );
+
+extern std::ostream &operator<<( std::ostream &os, const fi_spec_t &spec );
+
+#endif
