diff --git a/riscv/fi_impl.cc b/riscv/fi_impl.cc
new file mode 100644
index 00000000..b654f988
--- /dev/null
+++ b/riscv/fi_impl.cc
@@ -0,0 +1,129 @@
+#include "fi_impl.h"
+
+static std::default_random_engine prg;
+static std::independent_bits_engine<std::default_random_engine, 8 * sizeof( reg_t ), reg_t> bits;
+
+void fi_impl_init( cfg_t& cfg ) {
+  std::random_device trg;
+
+  if( cfg.fi_seed ) {
+     prg.seed( cfg.fi_seed );
+    bits.seed( cfg.fi_seed );
+  }
+  else {
+     prg.seed( trg() );
+    bits.seed( trg() );
+  }
+}
+
+#define DECODE_MACRO_USAGE_LOGGED 0
+bool fi_impl_step( processor_t* p, insn_t insn, reg_t pc, reg_t npc ) {
+  bool skip = false;
+
+  if( p->get_cfg().fi_trace ) {
+    std::cerr << "fi: trace => step = " << std::dec << p->state.fi_step << ", pc = " << std::setw( 16 ) << std::hex << pc << ", insn = " << p->get_disassembler()->disassemble( insn ) << std::endl;
+  }
+
+  if( ( insn.bits() & 0x000FFFFF ) == 0x00002013 ) {
+    std::cerr << "fi: mark => step = " << std::dec << p->state.fi_step << ", pc = " << std::setw( 16 ) << std::hex << pc << ", id = " << std::dec << insn.i_imm() << std::endl;
+  }
+
+  auto spec = p->get_cfg().fi_specs.find( p->state.fi_step );
+
+  if( spec != p->get_cfg().fi_specs.end() ) {
+    std::bernoulli_distribution dist( spec->second.prob ); bool trigger = dist( prg );
+
+    if( p->get_cfg().fi_debug ) {
+      std::cerr << "fi: debug => matched spec=" << spec->second << " ~> trigger=" << trigger << std::endl;
+    }
+
+    if( trigger ) {
+      switch( spec->second.type ) {
+        case SKIP : {
+          skip = true;
+
+          break;
+        }
+        case  GPR : {
+          if( p->get_cfg().fi_debug ) {
+            std::cerr << "fi: debug => >GPR[" << spec->second.gpr_addr << "]=" << std::hex << READ_REG( spec->second.gpr_addr ) << std::endl;
+          }
+
+          reg_t fault = 0;
+
+          switch( spec->second.gpr_mode ) {
+            case ZERO : {
+              fault =  0;     break;
+            }
+            case  ONE : {
+              fault = -1;     break;
+            }
+            case RAND : {
+              fault = bits(); break;
+            }
+          }
+
+          WRITE_REG( spec->second.gpr_addr, ( READ_REG( spec->second.gpr_addr ) & ~spec->second.gpr_mask ) | ( fault & spec->second.gpr_mask ) );
+
+          if( p->get_cfg().fi_debug ) {
+            std::cerr << "fi: debug => <GPR[" << spec->second.gpr_addr << "]=" << std::hex << READ_REG( spec->second.gpr_addr ) << std::endl;
+          }
+
+          break;
+        }
+      }
+    }
+  }
+
+  auto pc_spec = p->get_cfg().fi_pc_specs.find( pc );
+
+  if( pc_spec != p->get_cfg().fi_pc_specs.end() ) {
+    std::bernoulli_distribution dist( pc_spec->second.prob ); bool trigger = dist( prg );
+
+    if( p->get_cfg().fi_debug ) {
+      std::cerr << "fi: debug => matched pc_spec=" << pc_spec->second << " ~> trigger=" << trigger << std::endl;
+    }
+
+    if( trigger ) {
+      switch( pc_spec->second.type ) {
+        case SKIP : {
+          skip = true;
+
+          break;
+        }
+        case  GPR : {
+          if( p->get_cfg().fi_debug ) {
+            std::cerr << "fi: debug => >GPR[" << pc_spec->second.gpr_addr << "]=" << std::hex << READ_REG( pc_spec->second.gpr_addr ) << std::endl;
+          }
+
+          reg_t fault = 0;
+
+          switch( pc_spec->second.gpr_mode ) {
+            case ZERO : {
+              fault =  0;     break;
+            }
+            case  ONE : {
+              fault = -1;     break;
+            }
+            case RAND : {
+              fault = bits(); break;
+            }
+          }
+
+          WRITE_REG( pc_spec->second.gpr_addr, ( READ_REG( pc_spec->second.gpr_addr ) & ~pc_spec->second.gpr_mask ) | ( fault & pc_spec->second.gpr_mask ) );
+
+          if( p->get_cfg().fi_debug ) {
+            std::cerr << "fi: debug => <GPR[" << pc_spec->second.gpr_addr << "]=" << std::hex << READ_REG( pc_spec->second.gpr_addr ) << std::endl;
+          }
+
+          break;
+        }
+      }
+    }
+  }
+
+  p->state.fi_step = p->state.fi_step + 1;
+
+  return skip;
+}
+#undef DECODE_MACRO_USAGE_LOGGED
